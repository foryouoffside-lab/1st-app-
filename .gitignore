# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
.next-diag/
.next-build/
# scripts/app-smoke.cjs runs against its own dev server with
# NEXT_CAPTURE_DIST=.next-smoke, so a smoke run never shares .next with a
# normal dev server (see the distDir note in next.config.js).
.next-smoke/
out/
build/
dist/

# Environment files
.env
.env.local
.env.production
.env.development
.env*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# firebase-tools writes firebase-debug.log / firestore-debug.log into the repo
# root on every deploy; they carry project ids and command history.
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/

# TypeScript
*.tsbuildinfo

# npm
.npm

# Verification screenshots dropped next to the Playwright tests that took them.
# scripts/ holds test sources, not images.
scripts/*.png

# ESLint
.eslintcache
# Full-repo lint dumps (`eslint -f json > lint-audit.json`). A megabyte of
# generated findings that is stale the moment a file changes.
lint-audit.json

# Vercel
.vercel/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# Graphify knowledge graph output
graphify-out/
.next-previews/
previews-raw/

# Local scratch — never belongs in the repo.
# .design-review/ is a folder of review screenshots and drill-backups/ holds
# dated copies of drill files taken before a risky edit. Both are working
# material for one machine, both are megabytes of images/duplicates, and
# neither is something a fresh checkout needs.
.design-review/
drill-backups/

# Per-machine Claude Code settings (permissions/env for THIS checkout).
.claude/settings.local.json
