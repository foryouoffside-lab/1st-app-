<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer for the Flint mark: deep violet at the
  centre falling off to ink, drawn edge to edge so the launcher can mask it
  to whatever shape the device uses. Same colours as
  store-assets/flint/flint-icon.svg. The mark itself (Lock brackets + spark)
  is the foreground layer, ic_launcher_foreground.png.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="70%p"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#1d1438"
        android:endColor="#07070c" />
</shape>
