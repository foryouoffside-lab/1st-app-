<!-- Status-bar notification icon: the Flint mark (corner brackets + spark) as
     a flat white silhouette. Android tints status-bar icons itself, so every
     shape here is pure white on transparent — no colour, no gradient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The Lock: four corner brackets -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="square"
        android:pathData="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" />

    <!-- The spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,5 L13.1,10.9 L19,12 L13.1,13.1 L12,19 L10.9,13.1 L5,12 L10.9,10.9 Z" />
</vector>
