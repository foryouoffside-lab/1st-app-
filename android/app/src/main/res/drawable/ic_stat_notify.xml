<!-- Status-bar notification icon: the SkillDrills target mark, as a flat white
     silhouette. Android tints status-bar icons itself, so every shape here is
     pure white on transparent — no colour, no gradient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:pathData="M3.5,12 a8.5,8.5 0 1,1 17,0 a8.5,8.5 0 1,1 -17,0" />

    <!-- Centre dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,9.5 a2.5,2.5 0 1,1 0,5 a2.5,2.5 0 1,1 0,-5" />

    <!-- Crosshair ticks -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,1 L12,4.5 M12,19.5 L12,23 M1,12 L4.5,12 M19.5,12 L23,12" />
</vector>
