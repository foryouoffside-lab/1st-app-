<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ SplashScreen API icon (windowSplashScreenAnimatedIcon in
  styles.xml): the Flint mark — the Lock's four corner brackets around a
  struck spark — as real vector art, so it is crisp at every density. Same
  geometry as store-assets/flint/flint-icon.svg (512 viewport). The group
  scale keeps the mark small with generous padding inside the OS's 240dp
  slot, well within the 160dp circle the platform actually shows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.36"
        android:scaleY="0.36">

        <path
            android:strokeColor="#8b5cf6"
            android:strokeWidth="26"
            android:strokeLineCap="square"
            android:pathData="M118,196 V118 H196 M316,118 H394 V196 M394,316 V394 H316 M196,394 H118 V316" />

        <path android:pathData="M138,256 A118,118 0 1,0 374,256 A118,118 0 1,0 138,256 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="256"
                    android:centerY="256"
                    android:gradientRadius="118">
                    <item android:offset="0" android:color="#BFFBBF24" />
                    <item android:offset="0.45" android:color="#47F97316" />
                    <item android:offset="1" android:color="#00F97316" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#FFF7E0"
            android:pathData="M256,150 L270,242 L362,256 L270,270 L256,362 L242,270 L150,256 L242,242 Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M222,256 A34,34 0 1,0 290,256 A34,34 0 1,0 222,256 Z" />
    </group>
</vector>
