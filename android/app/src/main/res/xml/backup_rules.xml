<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup config (Android 6.0-11, API 23-30).

  Two exclusions, for two different reasons:

  1. app_webview/ — the WebView's own storage (localStorage/IndexedDB/cookies),
     which is where the cached user session (including email) lives. See
     contexts/AuthContext.js's SESSION_KEY.

  2. CapacitorStorage.xml — the SharedPreferences file @capacitor/preferences
     writes, i.e. ALL solo drill progress (sd_scores, sd_xp, sd_streak,
     sd_history). This used to be backed up deliberately so progress survived a
     phone upgrade. It had to stop, because it broke "Delete Account & Wipe
     Data": clearAllProgress() empties the file on the device, but Google still
     held the pre-wipe copy, and Android silently restored it on the next
     install. The player was told their data was permanently deleted and then
     watched their XP and drill counts come back. A delete that a cloud restore
     can undo is not a delete, and the delete screen's promise has to be true.

     The cost is that a restore-from-cloud onto a new phone now starts solo
     progress fresh. Identity is unaffected — username, photo, EIQ and the
     Arena record live in Firestore, not here.

  This file governs the old whole-app backup, which is the cloud path on those
  API levels, so progress must be excluded here. On API 31+ the split between
  cloud backup and direct device transfer is expressible, and
  data_extraction_rules.xml keeps progress on the transfer path.
-->
<full-backup-content>
    <exclude domain="root" path="app_webview/" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>
