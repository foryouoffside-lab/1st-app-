<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer config. Excludes the WebView's own
  storage (localStorage/IndexedDB/cookies), which is where the cached user
  session (including email) lives — see contexts/AuthContext.js's
  SESSION_KEY. Solo drill progress lives in @capacitor/preferences
  (SharedPreferences, a separate location) and is intentionally NOT excluded
  here, so it still survives cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
